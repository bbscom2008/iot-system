<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.DeviceWarningMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.entity.DeviceWarning">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="device_id" property="deviceId" jdbcType="BIGINT"/>
        <result column="device_num" property="deviceNum" jdbcType="VARCHAR"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="ta1" property="ta1" jdbcType="INTEGER"/>
        <result column="ts1" property="ts1" jdbcType="DOUBLE"/>
        <result column="ta2" property="ta2" jdbcType="INTEGER"/>
        <result column="ts2" property="ts2" jdbcType="DOUBLE"/>
        <result column="ta3" property="ta3" jdbcType="INTEGER"/>
        <result column="ts3" property="ts3" jdbcType="DOUBLE"/>
        <result column="ta4" property="ta4" jdbcType="INTEGER"/>
        <result column="ts4" property="ts4" jdbcType="DOUBLE"/>
        <result column="ha" property="ha" jdbcType="INTEGER"/>
        <result column="hv" property="hv" jdbcType="DOUBLE"/>
        <result column="na" property="na" jdbcType="INTEGER"/>
        <result column="nv" property="nv" jdbcType="DOUBLE"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO device_warnings
        (device_id, device_num, user_id,
         ta1, ts1, ta2, ts2, ta3, ts3, ta4, ts4,
         ha, hv, na, nv, created_at)
        VALUES
        (#{deviceId}, #{deviceNum}, #{userId},
         #{ta1}, #{ts1}, #{ta2}, #{ts2}, #{ta3}, #{ts3}, #{ta4}, #{ts4},
         #{ha}, #{hv}, #{na}, #{nv}, NOW())
    </insert>

    <!-- 查询报警列表 -->
    <select id="findList" resultMap="BaseResultMap">
        SELECT * FROM device_warnings
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
        </where>
        ORDER BY created_at DESC
        <if test="offset != null and pageSize != null">
            LIMIT #{offset}, #{pageSize}
        </if>
    </select>

    <!-- 查询报警总数 -->
    <select id="countWarning" resultType="long">
        SELECT COUNT(*) FROM device_warnings
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
        </where>
    </select>

    <!-- 清理设备报警 -->
    <delete id="deleteByDeviceNumAndUserId">
        DELETE FROM device_warnings
        WHERE device_num = #{deviceNum}
        <if test="userId != null">
            AND user_id = #{userId}
        </if>
    </delete>

</mapper>

