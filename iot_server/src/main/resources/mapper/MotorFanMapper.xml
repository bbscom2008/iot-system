    <!-- 查询所有风扇（关联设备和用户信息） -->
    <select id="findAll" resultMap="MotorFanListResultMap">
        SELECT 
            mf.*,
            d.device_name as device_name,
            u.nike_name as user_name,
            u.phone as user_phone
        FROM motor_fan mf
        LEFT JOIN devices d ON mf.device_id = d.id
        LEFT JOIN users u ON d.user_id = u.id
        <where>
            <if test="userName != null and userName != ''">
                AND u.nike_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="userPhone != null and userPhone != ''">
                AND u.phone LIKE CONCAT('%', #{userPhone}, '%')
            </if>
            <if test="deviceName != null and deviceName != ''">
                AND d.device_name LIKE CONCAT('%', #{deviceName}, '%')
            </if>
            <if test="deviceNum != null and deviceNum != ''">
                AND d.device_num LIKE CONCAT('%', #{deviceNum}, '%')
            </if>
            <if test="fanName != null and fanName != ''">
                AND mf.fan_name LIKE CONCAT('%', #{fanName}, '%')
            </if>
        </where>
        ORDER BY mf.created_time DESC
    </select>

    <!-- 根据父设备ID查询所有风扇 -->
    <select id="findByParentId" resultMap="BaseResultMap">
        SELECT * FROM motor_fan
        WHERE device_id = #{deviceId}
        ORDER BY id ASC
    </select>

    <!-- 根据风机编码查询所有风扇 -->
    <select id="findByFanCode" resultMap="BaseResultMap">
        SELECT * FROM motor_fan
        WHERE device_num = #{deviceNum}
        ORDER BY id ASC
    </select>

    <!-- 根据ID查询风扇 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM motor_fan WHERE id = #{id}
    </select>

    <!-- 根据设备ID 和 电机编号查询风扇 -->
    <select id="findByDeviceNumAndMotorNum" resultMap="BaseResultMap">
        SELECT * FROM motor_fan WHERE device_num = #{deviceNum} AND motor_num = #{motorNum}
    </select>

    <!-- 新增风扇 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO motor_fan (fan_name, device_id, device_num, is_running, wm, auto_mode, created_time, updated_time)
        VALUES (#{fanName}, #{deviceId}, #{deviceNum}, #{isRunning}, #{wm}, #{autoMode}, NOW(), NOW())
    </insert>

    <!-- 更新风扇运行状态 -->
    <update id="updateRunningStatus">
        UPDATE motor_fan
        SET is_running = #{isRunning}, updated_time = NOW()
        WHERE id = #{id}
    </update>

    <update id="updateRunningStatusByParentAndCode">
        UPDATE motor_fan
        SET is_running = #{isRunning}, updated_time = NOW()
        WHERE device_id = #{deviceId} AND device_num = #{deviceNum}
    </update>

    <!-- 批量更新风机运行状态 -->
    <update id="batchUpdateRunningStatusByParentId" parameterType="map">
        UPDATE motor_fan
        <set>
            is_running = CASE device_num
            <foreach collection="motorList" item="item" separator="">
                WHEN #{item.key} THEN #{item.value}
            </foreach>
            END,
            updated_time = NOW()
        </set>
        WHERE device_id = #{deviceId}
        AND device_num IN
        <foreach collection="motorList" item="item" open="(" close=")" separator=",">
            #{item.key}
        </foreach>
    </update>

