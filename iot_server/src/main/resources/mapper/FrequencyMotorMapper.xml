<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.FrequencyMotorMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.entity.FrequencyMotor">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="device_id" property="deviceId" jdbcType="BIGINT"/>
        <result column="device_num" property="deviceNum" jdbcType="VARCHAR"/>
        <result column="device_name" property="deviceName" jdbcType="VARCHAR"/>
        <result column="fcm" property="fcm" jdbcType="INTEGER"/>
        <result column="ms" property="ms" jdbcType="DOUBLE"/>
        <result column="mrtm" property="mrtm" jdbcType="INTEGER"/>
        <result column="mrts" property="mrts" jdbcType="INTEGER"/>
        <result column="mptm" property="mptm" jdbcType="INTEGER"/>
        <result column="mpts" property="mpts" jdbcType="INTEGER"/>

        <result column="atps" property="atps" jdbcType="INTEGER"/>
        <result column="atls" property="atls" jdbcType="DOUBLE"/>
        <result column="atul" property="atul" jdbcType="DOUBLE"/>
        <result column="atdl" property="atdl" jdbcType="DOUBLE"/>
        <result column="aswt" property="aswt" jdbcType="DOUBLE"/>
        <result column="atrtm" property="atrtm" jdbcType="INTEGER"/>
        <result column="atrts" property="atrts" jdbcType="INTEGER"/>
        <result column="atptm" property="atptm" jdbcType="INTEGER"/>
        <result column="atpts" property="atpts" jdbcType="INTEGER"/>

        <result column="ahls" property="ahls" jdbcType="DOUBLE"/>
        <result column="ahul" property="ahul" jdbcType="DOUBLE"/>
        <result column="ahdl" property="ahdl" jdbcType="DOUBLE"/>
        <result column="ahrtm" property="ahrtm" jdbcType="INTEGER"/>
        <result column="ahrts" property="ahrts" jdbcType="INTEGER"/>
        <result column="ahptm" property="ahptm" jdbcType="INTEGER"/>
        <result column="ahpts" property="ahpts" jdbcType="INTEGER"/>

        <result column="anls" property="anls" jdbcType="DOUBLE"/>
        <result column="anul" property="anul" jdbcType="DOUBLE"/>
        <result column="andl" property="andl" jdbcType="DOUBLE"/>
        <result column="anrtm" property="anrtm" jdbcType="INTEGER"/>
        <result column="anrts" property="anrts" jdbcType="INTEGER"/>
        <result column="anptm" property="anptm" jdbcType="INTEGER"/>
        <result column="anpts" property="anpts" jdbcType="INTEGER"/>

        <result column="value" property="value" jdbcType="INTEGER"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
        <result column="updated_time" property="updatedTime" jdbcType="TIMESTAMP"/>
        
        <!-- 设备和用户信息 -->
        <result column="parent_device_name" property="parentDeviceName" jdbcType="VARCHAR"/>
        <result column="parent_device_num" property="parentDeviceNum" jdbcType="VARCHAR"/>
        <result column="user_name" property="userName" jdbcType="VARCHAR"/>
        <result column="user_phone" property="userPhone" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 查询所有变频电机（关联设备和用户信息） -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT 
            fm.id,
            fm.device_id,
            fm.device_num,
            fm.device_name,
            fm.fcm,
            fm.ms,
            fm.mrtm,
            fm.mrts,
            fm.mptm,
            fm.mpts,
            fm.atps,
            fm.atls,
            fm.atul,
            fm.atdl,
            fm.aswt,
            fm.atrtm,
            fm.atrts,
            fm.atptm,
            fm.atpts,
            fm.ahls,
            fm.ahul,
            fm.ahdl,
            fm.ahrtm,
            fm.ahrts,
            fm.ahptm,
            fm.ahpts,
            fm.anls,
            fm.anul,
            fm.andl,
            fm.anrtm,
            fm.anrts,
            fm.anptm,
            fm.anpts,
            fm.value,
            fm.created_time,
            fm.updated_time,
            d.device_name as parent_device_name,
            d.device_num as parent_device_num,
            u.nike_name as user_name,
            u.phone as user_phone
        FROM frequency_motor fm
        LEFT JOIN devices d ON fm.device_id = d.id
        LEFT JOIN users u ON d.user_id = u.id
        <where>
            <if test="userName != null and userName != ''">
                AND u.nike_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="userPhone != null and userPhone != ''">
                AND u.phone LIKE CONCAT('%', #{userPhone}, '%')
            </if>
            <if test="deviceName != null and deviceName != ''">
                AND d.device_name LIKE CONCAT('%', #{deviceName}, '%')
            </if>
            <if test="deviceNum != null and deviceNum != ''">
                AND d.device_num LIKE CONCAT('%', #{deviceNum}, '%')
            </if>
            <if test="motorName != null and motorName != ''">
                AND fm.device_name LIKE CONCAT('%', #{motorName}, '%')
            </if>
            <if test="motorCode != null and motorCode != ''">
                AND fm.device_num LIKE CONCAT('%', #{motorCode}, '%')
            </if>
        </where>
        ORDER BY fm.created_time DESC
    </select>

    <!-- 根据父设备ID查询所有变频电机 -->
    <select id="findByParentId" resultMap="BaseResultMap">
        SELECT * FROM frequency_motor
        WHERE device_id = #{deviceId}
        ORDER BY id ASC
    </select>

    <!-- 根据设备编号查询所有变频电机 -->
    <select id="findByDeviceNum" resultMap="BaseResultMap">
        SELECT * FROM frequency_motor
        WHERE device_num = #{deviceNum}
        ORDER BY id ASC
    </select>

    <!-- 根据ID查询变频电机 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM frequency_motor WHERE id = #{id}
    </select>

    <!-- 新增变频电机 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO frequency_motor 
           (device_id, device_num, device_name, fcm, ms,
            mrtm, mrts, mptm, mpts,
            atps, atls, atul, atdl, aswt, atrtm, atrts, atptm, atpts,
            ahls, ahul, ahdl, ahrtm, ahrts, ahptm, ahpts,
            anls, anul, andl, anrtm, anrts, anptm, anpts,
            value, created_time, updated_time)
        VALUES 
           (#{deviceId}, #{deviceNum}, #{deviceName}, #{fcm}, #{ms},
            #{mrtm}, #{mrts}, #{mptm}, #{mpts},
            #{atps}, #{atls}, #{atul}, #{atdl}, #{aswt}, #{atrtm}, #{atrts}, #{atptm}, #{atpts},
            #{ahls}, #{ahul}, #{ahdl}, #{ahrtm}, #{ahrts}, #{ahptm}, #{ahpts},
            #{anls}, #{anul}, #{andl}, #{anrtm}, #{anrts}, #{anptm}, #{anpts},
            #{value}, NOW(), NOW())
    </insert>

    <!-- 更新变频电机配置 -->
    <update id="update">
        UPDATE frequency_motor
        <set>
            <if test="fcm != null">fcm = #{fcm},</if>
            <if test="ms != null">ms = #{ms},</if>
            <if test="mrtm != null">mrtm = #{mrtm},</if>
            <if test="mrts != null">mrts = #{mrts},</if>
            <if test="mptm != null">mptm = #{mptm},</if>
            <if test="mpts != null">mpts = #{mpts},</if>

            <if test="atps != null">atps = #{atps},</if>
            <if test="atls != null">atls = #{atls},</if>
            <if test="atul != null">atul = #{atul},</if>
            <if test="atdl != null">atdl = #{atdl},</if>
            <if test="aswt != null">aswt = #{aswt},</if>
            <if test="atrtm != null">atrtm = #{atrtm},</if>
            <if test="atrts != null">atrts = #{atrts},</if>
            <if test="atptm != null">atptm = #{atptm},</if>
            <if test="atpts != null">atpts = #{atpts},</if>

            <if test="ahls != null">ahls = #{ahls},</if>
            <if test="ahul != null">ahul = #{ahul},</if>
            <if test="ahdl != null">ahdl = #{ahdl},</if>
            <if test="ahrtm != null">ahrtm = #{ahrtm},</if>
            <if test="ahrts != null">ahrts = #{ahrts},</if>
            <if test="ahptm != null">ahptm = #{ahptm},</if>
            <if test="ahpts != null">ahpts = #{ahpts},</if>

            <if test="anls != null">anls = #{anls},</if>
            <if test="anul != null">anul = #{anul},</if>
            <if test="andl != null">andl = #{andl},</if>
            <if test="anrtm != null">anrtm = #{anrtm},</if>
            <if test="anrts != null">anrts = #{anrts},</if>
            <if test="anptm != null">anptm = #{anptm},</if>
            <if test="anpts != null">anpts = #{anpts},</if>

            <if test="value != null">value = #{value},</if>
            <if test="deviceName != null and deviceName != ''">device_name = #{deviceName},</if>
            updated_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除变频电机 -->
    <delete id="deleteById">
        DELETE FROM frequency_motor WHERE id = #{id}
    </delete>

    <!-- 删除父设备的所有变频电机 -->
    <delete id="deleteByParentId">
        DELETE FROM frequency_motor WHERE device_id = #{deviceId}
    </delete>

    
    <!-- 根据父设备ID和设备编号更新变频电机的当前值 -->
    <update id="updateValueByParentAndCode">
        UPDATE frequency_motor
        SET value = #{value},
            updated_time = NOW()
        WHERE device_id = #{deviceId} AND device_num = #{code}
    </update>
    
    <!-- 根据父设备ID批量更新变频电机的当前值 -->
    <update id="batchUpdateValueByParentId" parameterType="map">
        UPDATE frequency_motor
        <set>
            value = CASE device_num
            <foreach collection="list" item="item" separator="">
                WHEN #{item.key} THEN #{item.value}
            </foreach>
            END,
            updated_time = NOW()
        </set>
        WHERE device_id = #{deviceId}
        AND device_num IN
        <foreach collection="list" item="item" open="(" close=")" separator=",">
            #{item.key}
        </foreach>
    </update>

</mapper>